# cupcasa cups — environment variables

# Stripe (server) — required for online checkout
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
# (production uses STRIPE_API_KEY — the checkout route reads either)

# Stripe webhook signing secret — for order-confirmation emails (/api/webhooks/stripe)
# Create the endpoint in Stripe → Developers → Webhooks, then copy its signing secret.
STRIPE_WEBHOOK_SECRET=whsec_...

# Public site URL (used for Stripe redirect URLs in production)
NEXT_PUBLIC_SITE_URL=https://cups.cupcasa.com

# Lead emails (wholesale + contact forms) via Resend — https://resend.com
# Without RESEND_API_KEY, submissions are still logged but no email is sent.
RESEND_API_KEY=re_...
# Inbox that receives form submissions
LEADS_EMAIL=hello@cupcasa.com
# Sender. Use onboarding@resend.dev to start; switch to an address on a
# Resend-verified domain (e.g. leads@cupcasa.com) for production deliverability.
LEADS_FROM=cupcasa cups <onboarding@resend.dev>
# Resend Audience ID for the newsletter signup (Resend → Audiences)
RESEND_AUDIENCE_ID=

# ============================================================
# Portal + admin (Supabase, Twilio, cron). See README → "Portal + admin".
# ============================================================
# Supabase project (Dashboard → Project Settings → API). Local: `supabase status -o env`.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS. Never expose to the browser or commit.
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret pg_cron sends as "Authorization: Bearer …" to /api/cron/*. Same value goes in Vault (0004_cron.sql).
CRON_SECRET=

# Twilio (step 6). Use a Messaging Service SID or a From number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# Square (phase 2). 32-byte hex key for AES-256-GCM token encryption: `openssl rand -hex 32`
POS_TOKEN_ENC_KEY=
SQUARE_APP_ID=
SQUARE_APP_SECRET=
SQUARE_ENV=sandbox

# Twilio inbound webhook: set to the exact public URL Twilio calls, if signature checks fail behind a proxy.
TWILIO_WEBHOOK_URL=https://cups.cupcasa.com/api/webhooks/twilio
# Local development only: record SMS in the database instead of sending. NEVER set in production.
TWILIO_DRY_RUN=
