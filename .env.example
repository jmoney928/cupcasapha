# cupcasa cups — environment variables

# Stripe (server) — required for online checkout
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...

# Public site URL (used for Stripe redirect URLs in production)
NEXT_PUBLIC_SITE_URL=https://cups.cupcasa.com

# Lead emails (wholesale + contact forms) via Resend — https://resend.com
# Without RESEND_API_KEY, submissions are still logged but no email is sent.
RESEND_API_KEY=re_...
# Inbox that receives form submissions
LEADS_EMAIL=cupcasaadmin@gmail.com
# Sender. Use onboarding@resend.dev to start; switch to an address on a
# Resend-verified domain (e.g. leads@cupcasa.com) for production deliverability.
LEADS_FROM=cupcasa cups <onboarding@resend.dev>
